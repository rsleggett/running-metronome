<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Metronome body: bold white trapezoid (wider at base, narrower at top) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,52 L72,52 L88,88 L20,88 Z"/>

    <!-- Ghost pendulum at left extreme — subtle, suggests the beat arc -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,56 L41,22"/>

    <!-- Main pendulum — teal, swung right, suggests motion -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF6E40"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,56 L67,20"/>

    <!-- Sliding tempo weight on the pendulum, perpendicular to the rod -->
    <group
        android:pivotX="59"
        android:pivotY="39"
        android:rotation="22">
        <path
            android:fillColor="#FF6E40"
            android:pathData="M52,36 L66,36 L66,42 L52,42 Z"/>
    </group>

    <!-- Pivot dot where the rod meets the body top -->
    <path
        android:fillColor="#FF6E40"
        android:pathData="M51,52 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"/>

</vector>
